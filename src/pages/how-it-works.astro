---
import '../styles/global.css';
import SocialMeta from '../components/SocialMeta.astro';
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>How it works — dammeli</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<SocialMeta
			title="Come funziona — dammeli"
			description="Come dammeli cifra i tuoi metodi di pagamento prima ancora che lascino il telefono — spiegato senza tecnicismi."
			path="/how-it-works"
		/>
	</head>
	<body>
		<div class="ds-page">
			<div data-topbar></div>
			<div class="ds-body ds-body--lg-gap">
				<h1 data-title></h1>
				<div class="how-scenes" data-scenes></div>
				<p class="how-privacy-line" data-privacy-line></p>
				<div data-cta></div>
			</div>
		</div>
		<script type="module">
			import { initHowItWorks } from '../scripts/how-it-works.mjs';
			initHowItWorks();
		</script>
	</body>
</html>
