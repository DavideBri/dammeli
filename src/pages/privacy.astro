---
import '../styles/global.css';
import SocialMeta from '../components/SocialMeta.astro';
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Privacy — dammeli</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<SocialMeta
			title="Privacy — dammeli"
			description="Chi ospita dammeli, cosa vede e cosa non vediamo mai — spiegato in chiaro."
			path="/privacy"
		/>
	</head>
	<body>
		<div class="ds-page">
			<div data-topbar></div>
			<div class="ds-body ds-body--lg-gap">
				<div>
					<h1 data-title></h1>
					<p class="how-intro" data-intro></p>
				</div>
				<div class="privacy-quickfacts" data-quickfacts></div>
				<div class="privacy-sections" data-sections></div>
				<div data-beta-notice></div>
				<div data-back></div>
			</div>
		</div>
		<script type="module">
			import { initPrivacy } from '../scripts/privacy.mjs';
			initPrivacy();
		</script>
	</body>
</html>
