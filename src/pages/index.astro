---
import '../styles/global.css';
---
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>damme.li</title>
		<link rel="icon" href="data:," />
		<script type="module" src="/crypto.js"></script>
	</head>
	<body class="min-h-screen bg-neutral-50 text-neutral-900">
		<main class="mx-auto max-w-md px-4 py-8">
			<h1 class="text-2xl font-semibold">dammeli</h1>
			<p class="mt-1 text-neutral-600">Collect your payment methods, get one link to share.</p>

			<form id="editor" class="mt-8">
				<div id="methods" class="flex flex-col gap-4">
					<fieldset class="method-card rounded-lg border border-neutral-200 bg-white p-4" data-method="satispay">
						<legend class="px-1 font-medium">Satispay</legend>
						<!--
							TODO(content): placeholder instructions. PLAN.md section 7
							requires the real, current button names from inside the
							Satispay app, not a guess — needs verifying against the
							live app before this ships.
						-->
						<p class="text-sm text-neutral-600">Open the Satispay app and find your @handle.</p>
						<label class="mt-3 block text-sm font-medium" for="satispay-value">Your Satispay handle</label>
						<input
							id="satispay-value"
							type="text"
							data-role="value"
							autocomplete="off"
							placeholder="e.g. brunoxyz"
							class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 focus:border-neutral-500 focus:outline-none"
						/>
						<p class="confirm mt-2 text-sm text-emerald-700" data-confirm hidden></p>
						<div class="reorder mt-3 flex gap-2">
							<button type="button" data-move="up" aria-label="Move Satispay up" class="rounded-md border border-neutral-300 px-2 py-1 text-sm hover:bg-neutral-100">&uarr;</button>
							<button type="button" data-move="down" aria-label="Move Satispay down" class="rounded-md border border-neutral-300 px-2 py-1 text-sm hover:bg-neutral-100">&darr;</button>
						</div>
					</fieldset>

					<fieldset class="method-card rounded-lg border border-neutral-200 bg-white p-4" data-method="revolut">
						<legend class="px-1 font-medium">Revolut</legend>
						<!-- TODO(content): same as above, needs the real current steps. -->
						<p class="text-sm text-neutral-600">Open Revolut, tap your name in the top left: your @username is right below.</p>
						<label class="mt-3 block text-sm font-medium" for="revolut-value">Your Revolut username</label>
						<input
							id="revolut-value"
							type="text"
							data-role="value"
							autocomplete="off"
							placeholder="e.g. brunoxyz"
							class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 focus:border-neutral-500 focus:outline-none"
						/>
						<p class="confirm mt-2 text-sm text-emerald-700" data-confirm hidden></p>
						<div class="reorder mt-3 flex gap-2">
							<button type="button" data-move="up" aria-label="Move Revolut up" class="rounded-md border border-neutral-300 px-2 py-1 text-sm hover:bg-neutral-100">&uarr;</button>
							<button type="button" data-move="down" aria-label="Move Revolut down" class="rounded-md border border-neutral-300 px-2 py-1 text-sm hover:bg-neutral-100">&darr;</button>
						</div>
					</fieldset>

					<fieldset class="method-card rounded-lg border border-neutral-200 bg-white p-4" data-method="paypal">
						<legend class="px-1 font-medium">PayPal</legend>
						<p class="text-sm text-neutral-600">Paste your PayPal.me link, or just your handle.</p>
						<label class="mt-3 block text-sm font-medium" for="paypal-value">Your PayPal.me link or handle</label>
						<input
							id="paypal-value"
							type="text"
							data-role="value"
							autocomplete="off"
							placeholder="e.g. paypal.me/brunoxyz"
							class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 focus:border-neutral-500 focus:outline-none"
						/>
						<p class="mt-2 text-sm text-neutral-600">Don't have one yet? <a class="text-neutral-900 underline underline-offset-2" href="https://www.paypal.com/paypalme/" target="_blank" rel="noopener noreferrer">Create a PayPal.me link</a>.</p>
						<p class="confirm mt-2 text-sm text-emerald-700" data-confirm hidden></p>
						<div class="reorder mt-3 flex gap-2">
							<button type="button" data-move="up" aria-label="Move PayPal up" class="rounded-md border border-neutral-300 px-2 py-1 text-sm hover:bg-neutral-100">&uarr;</button>
							<button type="button" data-move="down" aria-label="Move PayPal down" class="rounded-md border border-neutral-300 px-2 py-1 text-sm hover:bg-neutral-100">&darr;</button>
						</div>
					</fieldset>

					<fieldset class="method-card rounded-lg border border-neutral-200 bg-white p-4" data-method="iban">
						<legend class="px-1 font-medium">IBAN</legend>
						<p class="text-sm text-neutral-600">Spaces are fine, we'll clean it up.</p>
						<label class="mt-3 block text-sm font-medium" for="iban-value">IBAN</label>
						<input
							id="iban-value"
							type="text"
							data-role="value"
							autocomplete="off"
							placeholder="IT60 X054 2811 1010 0000 0123 456"
							class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 focus:border-neutral-500 focus:outline-none"
						/>
						<label class="mt-3 block text-sm font-medium" for="iban-holder">Account holder, exactly as it appears at your bank</label>
						<p class="mt-1 text-xs text-neutral-500">
							Banks now check this name against the IBAN (Verification of Payee). A mismatch can block the transfer.
						</p>
						<input
							id="iban-holder"
							type="text"
							data-role="holder"
							autocomplete="off"
							placeholder="Full name as registered"
							class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 focus:border-neutral-500 focus:outline-none"
						/>
						<p class="confirm mt-2 text-sm text-emerald-700" data-confirm hidden></p>
						<div class="reorder mt-3 flex gap-2">
							<button type="button" data-move="up" aria-label="Move IBAN up" class="rounded-md border border-neutral-300 px-2 py-1 text-sm hover:bg-neutral-100">&uarr;</button>
							<button type="button" data-move="down" aria-label="Move IBAN down" class="rounded-md border border-neutral-300 px-2 py-1 text-sm hover:bg-neutral-100">&darr;</button>
						</div>
					</fieldset>
				</div>

				<details id="other-methods" class="mt-4 rounded-lg border border-neutral-200 bg-white p-4">
					<summary class="cursor-pointer font-medium">Other methods</summary>
					<fieldset class="method-card mt-3" data-method="crypto">
						<legend class="px-1 font-medium">Crypto</legend>
						<label class="mt-3 block text-sm font-medium" for="crypto-type">Type</label>
						<select
							id="crypto-type"
							data-role="type"
							class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 focus:border-neutral-500 focus:outline-none"
						>
							<option value="bitcoin">Bitcoin</option>
						</select>
						<label class="mt-3 block text-sm font-medium" for="crypto-value">Address</label>
						<input
							id="crypto-value"
							type="text"
							data-role="value"
							autocomplete="off"
							placeholder="bc1... or sp1..."
							class="mt-1 w-full rounded-md border border-neutral-300 px-3 py-2 focus:border-neutral-500 focus:outline-none"
						/>
						<p class="confirm mt-2 text-sm text-emerald-700" data-confirm hidden></p>
					</fieldset>
				</details>
			</form>
		</main>
		<script type="module">
			import { initEditor } from '../scripts/editor.mjs';
			initEditor(document.getElementById('editor'));
		</script>
	</body>
</html>
