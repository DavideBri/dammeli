---
import '../styles/global.css';
---
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>damme.li</title>
		<link rel="icon" href="data:," />
		<script type="module" src="/crypto.js"></script>
	</head>
	<body>
		<div id="app">
			<section class="ds-page" data-screen="editor" hidden>
				<div data-topbar-editor></div>
				<div class="ds-body">
					<div class="editor-intro">
						<div data-editor-kicker></div>
						<h1 data-editor-h1></h1>
						<p data-editor-subtitle class="editor-subtitle"></p>
					</div>

					<div data-title-field></div>

					<div class="editor-methods-section">
						<div class="editor-methods-heading-row">
							<h3 data-editor-methods-heading></h3>
							<div data-filled-count></div>
						</div>
						<div>
							<div class="ds-method-grid__buttons" data-method-tiles></div>
							<div data-method-popover-wrap></div>
						</div>
					</div>

					<p data-editor-footnote class="editor-footnote"></p>
					<p data-create-error class="ds-field__error" hidden></p>
				</div>
				<div class="ds-sticky">
					<button type="button" class="ds-btn ds-btn--primary ds-btn--lg ds-btn--full" data-create disabled></button>
				</div>
			</section>

			<section class="ds-page" data-screen="created" hidden>
				<div data-topbar-created></div>
				<div class="ds-body ds-body--lg-gap">
					<div class="created-intro">
						<div data-created-badge></div>
						<h2 data-created-title></h2>
						<p class="created-url" data-read-link></p>
					</div>

					<div class="created-actions">
						<div data-copy-link-btn></div>
						<div data-whatsapp-btn></div>
					</div>

					<div class="ds-card ds-card--sunken created-qr-card">
						<div class="created-qr-frame" data-qr></div>
						<div data-qr-hint></div>
					</div>

					<div data-keep-link-notice></div>

					<div class="created-ghost-row">
						<div data-view-public-btn></div>
						<div data-created-your-pages-btn></div>
					</div>

					<p class="created-edit-link" data-edit-link hidden></p>
					<div data-copy-edit-link-btn></div>
				</div>
			</section>

			<section class="ds-page" data-screen="your-pages" hidden>
				<div data-topbar-your-pages></div>
				<div class="ds-body ds-body--flush">
					<ul data-your-pages-list class="your-pages-list"></ul>
					<div class="your-pages-notice-wrap" data-your-pages-notice></div>
				</div>
			</section>

			<section class="ds-page" data-screen="viewer" hidden>
				<div data-topbar-viewer></div>
				<div class="ds-body ds-body--lg-gap">
					<p data-viewer-state="loading" hidden></p>
					<div data-viewer-state="error" hidden></div>
					<div data-viewer-state="loaded" hidden class="viewer-loaded">
						<div class="viewer-heading">
							<div data-page-kicker></div>
							<h1 class="viewer-title" data-page-title></h1>
						</div>
						<div data-methods class="viewer-methods"></div>
						<div data-iban-card hidden></div>
						<p class="viewer-footer" data-viewer-footer></p>
					</div>
				</div>
			</section>
		</div>
		<script type="module">
			import { boot } from '../scripts/app.mjs';
			boot();
		</script>
	</body>
</html>
