---
// Open Graph / Twitter card tags, shared across the three static pages.
// One static og:image for the whole site (public/og-image.png, built from
// src/vendor/marks.mjs's own icons so it can't drift from the real UI) —
// a per-page dynamic image isn't possible here without breaking the
// privacy model: a shared page's title/methods live only in the URL
// fragment (PLAN.md section 3), which by design never reaches the server
// that would need to read it to render one.
interface Props {
	title: string;
	description: string;
	path: string;
}
const { title, description, path } = Astro.props;
const SITE = 'https://damme.li';
const image = `${SITE}/og-image.png`;
const url = `${SITE}${path}`;
---
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="dammeli" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="dammeli" />
<meta property="og:locale" content="it_IT" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
