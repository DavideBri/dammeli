# Copia in .env (gia' in .gitignore) per sviluppo locale con Netlify CLI.
# Le stesse variabili vanno impostate anche in Netlify: Site settings ->
# Environment variables. Mai la anon key qui: solo la service role key, che
# bypassa la RLS della tabella pages (vedi sql/schema.sql).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
