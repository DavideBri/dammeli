# Copy to .env (already in .gitignore) for local development with the
# Netlify CLI. The same variables also need to be set in Netlify: Site
# settings -> Environment variables. Never the anon key here: only the
# service role key, which bypasses RLS on the pages table (see
# sql/schema.sql).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
